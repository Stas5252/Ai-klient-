{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-lead-machine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "MAX_SOURCE_REQUESTS_DAY": "1000",
    "FRESH_WINDOW_MINUTES": "60",
    "RETENTION_DAYS": "90"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-lead-machine",
      "database_id": "7da5bbb4-832a-4467-bdc9-367e43c58a1c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
