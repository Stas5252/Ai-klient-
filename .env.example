# Скопировать только в закрытый .dev.vars или добавить в secrets окружения.
# Не вставлять значения в чат, issues, commits или README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_IDS=
ADMIN_CHAT_ID=
ADMIN_API_KEY=
SUPPRESSION_SALT=
# Секреты deploy, не нужны внутри Worker
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Не секретные ограничители
MAX_SOURCE_REQUESTS_DAY=1000
FRESH_WINDOW_MINUTES=60
RETENTION_DAYS=90
# Опционально: маленькая область <0.02° по каждой оси, например центр Москвы
BUSINESS_BBOX=
# Официальные разрешённые API. Не вставлять значения в чат.
# Threads: требуются approved threads_keyword_search и threads_basic
THREADS_ACCESS_TOKEN=
# Только после App Review и реального preflight поста чужого автора; не ставить заранее
THREADS_PUBLIC_SEARCH_VERIFIED=0
# VK: необходим подтверждённый доступ к newsfeed.search
VK_ACCESS_TOKEN=
