# Скопировать только в закрытый .dev.vars или добавить в secrets окружения.
# Не вставлять значения в чат, issues, commits или README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_IDS=
ADMIN_CHAT_ID=
ADMIN_API_KEY=
SUPPRESSION_SALT=
# Секреты deploy, не нужны внутри Worker
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Не секретные ограничители
MAX_SOURCE_REQUESTS_DAY=200
RETENTION_DAYS=90
# Опционально: маленькая область <0.02° по каждой оси, например центр Москвы
BUSINESS_BBOX=
# Только явно разрешённые группы/каналы, где присутствует бот
TELEGRAM_GROUP_IDS=
